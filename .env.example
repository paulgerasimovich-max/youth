# Скопируйте этот файл в .env.local и подставьте значения проекта Youth
# (Supabase → Project Settings → API). Оба значения публичные; секретный ключ
# (secret / service_role) сюда класть НЕЛЬЗЯ.
# Если файла .env.local нет, приложение запускается в демо-режиме на выдуманных данных.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
