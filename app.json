{
  "expo": {
    "name": "Woodmark Youth",
    "slug": "woodmark-youth",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.woodmarkyouth.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#3B2560",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.woodmarkyouth.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-sqlite",
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Lets you share photos and videos with your group.",
          "cameraPermission": "Lets you take photos to share with your group.",
          "microphonePermission": false
        }
      ],
      "expo-notifications",
      "expo-splash-screen",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#20152E",
          "image": "./assets/splash-icon.png",
          "imageWidth": 140
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "5ff701ee-b0b5-49c6-8227-c740b742adf9"
      }
    },
    "owner": "woodmark-youth"
  }
}
